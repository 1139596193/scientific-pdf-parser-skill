{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScientificDocResultFallbackSchema",
  "description": "Standard fallback output schema for scientific literature parsing when case.json does not specify detailed field definitions.",
  "type": "object",
  "required": ["case_id", "status", "document", "sources", "uncertainty"],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "Unique identifier matching the input case.json"
    },
    "status": {
      "type": "string",
      "enum": ["success", "partial", "unverifiable", "failed"],
      "description": "Honest task execution status"
    },
    "document": {
      "type": "object",
      "required": ["title", "sections"],
      "properties": {
        "title": { "type": "string" },
        "authors": { "type": "array", "items": { "type": "string" } },
        "abstract": { "type": "string" },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["heading", "content"],
            "properties": {
              "heading": { "type": "string" },
              "content": { "type": "string" },
              "page": { "type": "integer", "minimum": 1 },
              "evidence_block_id": { "type": "string" }
            }
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["table_id", "markdown", "evidence_sources"],
            "properties": {
              "table_id": { "type": "string" },
              "caption": { "type": ["string", "null"] },
              "markdown": { "type": "string" },
              "html": { "type": "string" },
              "source_pages": { "type": "array", "items": { "type": "integer" } },
              "evidence_sources": { "type": "array" }
            }
          }
        },
        "formulas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "formula_id": { "type": ["string", "null"] },
              "latex": { "type": "string" },
              "page": { "type": "integer" }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_or_field", "page"],
        "properties": {
          "claim_or_field": { "type": "string" },
          "page": { "type": "integer" },
          "block_id": { "type": "string" },
          "bbox": { "type": "array", "items": { "type": "number" } }
        }
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "reason"],
        "properties": {
          "item": { "type": "string" },
          "reason": { "type": "string" },
          "suggested_manual_check_location": { "type": "string" }
        }
      }
    },
    "diagnostics_summary": {
      "type": "object",
      "properties": {
        "total_pages": { "type": "integer" },
        "dominant_route": { "type": "string" },
        "is_ocr_fallback_used": { "type": "boolean" }
      }
    }
  }
}
